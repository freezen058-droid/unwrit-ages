<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk/>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- See https://developer.android.com/training/tv/start/start -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:glEsVersion="0x00020000" android:required="false" />

    <!--
        Package visibility (Android 11+ / API 30+) for Solana Mobile Wallet Adapter: without this,
        the implicit intent MWA uses to find/launch an installed wallet app (Phantom, Solflare,
        etc) may silently fail to resolve any wallet even when one is installed.
        Verified against the MWA 2.0 spec (solana-mobile.github.io/mobile-wallet-adapter/spec):
        the local-association intent is "solana-wallet:/v1/associate/local?..." - scheme
        "solana-wallet" is correct and sufficient here, no per-wallet <package> entries needed.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="solana-wallet" />
        </intent>
    </queries>

    <!--
        Known Lint warnings:
            UnusedAttribute: Since we're targeting a range of API levels, it's OK that e.g. appCategory will be ignored by OLD devices
            IconDensities: See https://developer.android.com/training/tv/start/start#banner for the banner attribute, where they recommend supplying only one density.
    -->
    <!-- Cleartext traffic permission solely so users can host their own server without setting up https -->
    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:icon="@mipmap/appicon"
        android:roundIcon="@mipmap/appicon_round"
        android:label="@string/app_name"
        android:isGame="true"
        android:largeHeap="true"
        android:appCategory="game"
        android:banner="@drawable/banner"
        android:theme="@style/GdxTheme" >
        <activity
            android:name="com.unciv.app.AndroidLauncher"
            android:launchMode="singleTask"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="userLandscape"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true" >
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="unciv.app"
                    android:path="/multiplayer"
                    />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="yairm210.github.io" />
                <data android:pathPrefix="/Unciv/G/" />
                <data android:pathPrefix="/Unciv/g/" />
                <data android:pathPrefix="/unciv/G/" />
                <data android:pathPrefix="/unciv/g/" />
                <data android:pathPrefix="/Unciv/P/" />
                <data android:pathPrefix="/Unciv/p/" />
                <data android:pathPrefix="/unciv/P/" />
                <data android:pathPrefix="/unciv/p/" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.unciv.app.AndroidTvLauncher"
            android:exported="true"
            android:theme="@style/GdxTheme">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".CopyToClipboardReceiver"  android:exported="false" />

        <!-- Transparent bridge Activity to host Mobile Wallet Adapter transact() calls, which
             require a ComponentActivity - see WalletBridgeActivity.kt for why.
             screenOrientation/configChanges match AndroidLauncher's: without this, this activity
             (and the wallet app's own approval UI on top of it) follows the device's sensor
             orientation while AndroidLauncher underneath is locked to landscape - the resulting
             orientation mismatch/config change destroys and recreates this activity mid-flight,
             cancelling its lifecycleScope (and with it the in-progress transact() call) before the
             wallet app can respond. Confirmed via logcat: a "config changes=... land" transition
             lines up exactly with a JobCancellationException from AndroidWalletService. -->
        <activity
            android:name="com.unciv.app.WalletBridgeActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="userLandscape"
            android:exported="false" />
    </application>

</manifest>
