<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk/>

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only what the game uses (09-26). Notifications, boot and foreground-service permissions
         served upstream's multiplayer turn checker, which is off in this fork (its code is kept;
         restore these three if multiplayer comes back). REORDER_TASKS came from androidx.test,
         which the wallet library wrongly ships as a runtime dependency (excluded in
         build.gradle.kts). Kept, from libraries: ACCESS_NETWORK_STATE, WAKE_LOCK (the wallet
         flow holds a wake lock), and androidx.core's app-private receiver permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.REORDER_TASKS" tools:node="remove" />
    <!-- See https://developer.android.com/training/tv/start/start -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:glEsVersion="0x00020000" android:required="false" />

    <!--
        Package visibility (Android 11+ / API 30+) for Solana Mobile Wallet Adapter: without this,
        the implicit intent MWA uses to find/launch an installed wallet app (Phantom, Solflare,
        etc) may silently fail to resolve any wallet even when one is installed.
        Verified against the MWA 2.0 spec (solana-mobile.github.io/mobile-wallet-adapter/spec):
        the local-association intent is "solana-wallet:/v1/associate/local?..." - scheme
        "solana-wallet" is correct and sufficient here, no per-wallet <package> entries needed.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="solana-wallet" />
        </intent>
    </queries>

    <!--
        Known Lint warnings:
            UnusedAttribute: Since we're targeting a range of API levels, it's OK that e.g. appCategory will be ignored by OLD devices
            IconDensities: See https://developer.android.com/training/tv/start/start#banner for the banner attribute, where they recommend supplying only one density.
    -->
    <!-- Internet traffic requires TLS; MWA's encrypted local session uses a loopback WebSocket. -->
    <application
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:icon="@mipmap/appicon"
        android:roundIcon="@mipmap/appicon_round"
        android:label="@string/app_name"
        android:isGame="true"
        android:largeHeap="true"
        android:appCategory="game"
        android:banner="@drawable/banner"
        android:theme="@style/GdxTheme" >
        <activity
            android:name="com.unciv.app.AndroidLauncher"
            android:launchMode="singleTask"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:screenOrientation="userLandscape"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Upstream's links (https://unciv.app/multiplayer, yairm210.github.io/Unciv/G/...)
                 opened this app to join an online game; this fork has no multiplayer and is not
                 that site, so it claims no links (09-24). -->
        </activity>

        <activity
            android:name="com.unciv.app.AndroidTvLauncher"
            android:exported="true"
            android:theme="@style/GdxTheme">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".CopyToClipboardReceiver"  android:exported="false" />

        <!-- Transparent bridge Activity to host Mobile Wallet Adapter transact() calls, which
             require a ComponentActivity - see WalletBridgeActivity.kt for why.
             configChanges is what keeps the in-progress transact() alive: declaring
             orientation|screenSize means the system hands this activity a configuration change
             instead of destroying and recreating it, which used to cancel its lifecycleScope
             mid-flight (a "config changes=... land" transition lined up exactly with a
             JobCancellationException from AndroidWalletService).

             taskAffinity puts this activity - and the wallet's approval sheet, which the system
             launches into the same task - in a task of their own, away from AndroidLauncher.
             Everything else here follows from that. The wallet sheet declares
             SCREEN_ORIENTATION_PORTRAIT while the game is landscape, and with all three in one
             task there was no arrangement that worked: pinning this activity to landscape forced
             the sheet sideways so the player had nothing to approve, and leaving it unpinned let
             the display rotate to portrait and back, after which the menu came back as one flat
             colour. In its own task the sheet rotates freely and the game's task is never touched.

             It also fixes what happened when a player walked away from the approval sheet: the
             abandoned sheet used to be the only thing left in the game's task, so tapping the
             launcher icon resumed that task and bounced straight back to the home screen, and the
             game could only be reached again by force-stopping it. -->
        <activity
            android:name="com.unciv.app.WalletBridgeActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:taskAffinity=":wallet"
            android:exported="false" />
    </application>

</manifest>
